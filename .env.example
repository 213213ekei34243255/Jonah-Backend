# Jonah Search configuration. Copy to .env for local development (cp .env.example .env).
# On Render, set these under Environment instead. Never commit a real .env.
# Every value is optional: with nothing set, the service starts and answers from Wikipedia only.
# Comments are on their own lines on purpose: `docker run --env-file` would keep an inline comment as part of the value.

# ==================================================================== general
APP_NAME=Jonah Search
# "production" adds HSTS
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Sent with every request this service makes. Put a URL or e-mail where site owners can reach you.
USER_AGENT=JonahSearchBot/1.0 (+https://github.com/your-account/jonah-search)
# Comma-separated browser origins allowed to call the API from a web page. Empty = no CORS headers.
CORS_ORIGINS=

# ==================================================================== authentication and rate limiting
# Clients send "Authorization: Bearer <key>". Several keys can be comma-separated. Empty = no authentication (local use only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SEARCH_API_KEY=
# The shared secret the existing Jonah apps send as the X-Jonah-Key header (the old proxy's APP_SHARED_SECRET). Accepted like a key.
APP_SHARED_SECRET=
# Requests per minute per API key (or per client IP without a key). 0 disables.
RATE_LIMIT_PER_MINUTE=60
# true behind Render or another load balancer you control (reads the client IP from X-Forwarded-For)
TRUST_PROXY_HEADERS=false
# How many proxies you control append to X-Forwarded-For (Render: 1)
TRUSTED_PROXY_HOPS=1

# ==================================================================== providers
# Tried in this order in fast mode. Providers without their settings are skipped automatically.
PROVIDER_PRIORITY=searxng,brave,bing,google,wikipedia
# SearXNG (recommended). One URL, or several comma-separated, tried in order. The instance must have the JSON format enabled.
SEARXNG_URL=
# Brave Search API key: https://api-dashboard.search.brave.com
BRAVE_API_KEY=
# Bing Web Search API. Microsoft retired it in August 2025: only set this if you still have a working endpoint.
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# Google Programmable Search: API key + search engine ID (cx). The free tier is 100 queries per day.
# Also used by /search/web, /search/images and /search/videos. GOOGLE_CSE_ID (the old proxy's name) works instead of GOOGLE_CX.
GOOGLE_API_KEY=
GOOGLE_CX=
# Keyless last resort (MediaWiki API). Keep it last in PROVIDER_PRIORITY.
ENABLE_WIKIPEDIA=true
# Providers queried in parallel when mode=deep
DEEP_MODE_MAX_PROVIDERS=4

# ==================================================================== news and image source finding
# NewsAPI key (https://newsapi.org) for /news/headlines, /news/search and /news/sources
NEWS_API_KEY=
# Country for /news/headlines when the request does not give one
NEWS_DEFAULT_COUNTRY=in
# Seconds NewsAPI answers are reused (the free plan allows 100 requests a day). 0 disables.
NEWS_CACHE_TTL_SECONDS=300
# Google Cloud Vision key for /search/image-source. Empty = use GOOGLE_API_KEY (then enable the Vision API for that key's project).
GOOGLE_VISION_API_KEY=
# Largest image sent to Cloud Vision, in MB (uploads, and images this server downloads when Google cannot)
MAX_IMAGE_MB=4
# Largest request body accepted, in MB
MAX_REQUEST_BODY_MB=8

# ==================================================================== shopping (eBay Browse API, /shopping/ebay)
# From your eBay developer keyset: "App ID (Client ID)" and "Cert ID (Client Secret)"
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (default) or sandbox - must match the keyset (sandbox keys start with SBX-, production keys contain PRD-)
EBAY_ENVIRONMENT=production
# Default marketplace (eBay has no Indian site)
EBAY_MARKETPLACE_ID=EBAY_US
# Optional: your eBay Partner Network campaign id (results then also carry commission links, itemAffiliateWebUrl)
EBAY_AFFILIATE_CAMPAIGN_ID=

# ==================================================================== page fetching (fetch_content=true)
# Seconds per provider call and per page
REQUEST_TIMEOUT_SECONDS=10
# Ceiling for fetching all pages of one request
FETCH_TOTAL_TIMEOUT_SECONDS=20
MAX_PAGE_SIZE_MB=5
MAX_REDIRECTS=5
# Upper bound for the max_results parameter
MAX_RESULTS=20
# Characters of extracted text kept per page
MAX_CONTENT_LENGTH=50000
# HTML processed per page (extraction cost grows with page size)
MAX_EXTRACT_HTML_KB=400
MAX_CONCURRENT_FETCHES=5
# Outbound ports the page fetcher may connect to
ALLOWED_PORTS=80,443
# Keep true
RESPECT_ROBOTS=true
# If robots.txt cannot be read (5xx or network error): false = do not fetch the page
ROBOTS_FAIL_OPEN=false

# ==================================================================== cache
# Search results, seconds (0 disables)
CACHE_TTL_SECONDS=300
# Extracted pages, seconds (0 disables)
PAGE_CACHE_TTL_SECONDS=900
# In-memory cache only
CACHE_MAX_ENTRIES=1000
# Optional. With Redis the cache and the rate limit are shared by every worker/instance; without it both live in memory.
REDIS_URL=

# ==================================================================== developer access (the Mac app's sign-in) and the /admin/ console
# Where the accounts database lives. In production this must be on a persistent disk. Unset in development = ./data/license
LICENSE_DATA_DIR=
# First Developer Console administrator (password: 12+ characters; empty = a random one is printed once in the log)
LICENSE_ADMIN_USERNAME=
LICENSE_ADMIN_PASSWORD=
# true = set that administrator's password from LICENSE_ADMIN_PASSWORD at every start (lost-password recovery); turn it off again afterwards
LICENSE_ADMIN_RESET_PASSWORD=false
# Accounts to create at start if missing, JSON. Holds plaintext passwords: use once, then remove.
LICENSE_SEED_ACCOUNTS=
# Ed25519 private key (PEM, or its base64). Empty = created once inside LICENSE_DATA_DIR.
LICENSE_SIGNING_KEY=
# Comma-separated IPs allowed to open the console (empty = anywhere; it still needs the administrator sign-in)
LICENSE_ADMIN_ALLOWED_IPS=
# Requests per minute for a signed-in developer account. 0 = not rate-limited.
LICENSE_UNLIMITED_RATE_LIMIT_PER_MINUTE=0
# false switches developer access off completely
LICENSE_ENABLED=true
